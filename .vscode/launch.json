{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "StockInvestment HTTP",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build StockInvestment",
      "program": "${workspaceFolder}/bin/Debug/net10.0/StockInvestment.dll",
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5084"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    },
    {
      "name": "StockInvestment HTTPS",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build StockInvestment",
      "program": "${workspaceFolder}/bin/Debug/net10.0/StockInvestment.dll",
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7216;http://localhost:5084"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}