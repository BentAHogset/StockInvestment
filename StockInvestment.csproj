<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>frontend</SpaRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.0" />
  </ItemGroup>

  <!-- SPA sources are built separately into wwwroot, not shipped as .NET content -->
  <ItemGroup>
    <Content Remove="$(SpaRoot)/**" />
    <Compile Remove="$(SpaRoot)/**" />
    <None Remove="$(SpaRoot)/**" />
  </ItemGroup>

  <Target Name="NpmInstall" BeforeTargets="Build;Publish" Condition="!Exists('$(SpaRoot)/node_modules')">
    <Exec Command="npm ci" WorkingDirectory="$(SpaRoot)" />
  </Target>

  <Target Name="NpmBuild" BeforeTargets="Build;Publish">
    <Exec Command="npm run build" WorkingDirectory="$(SpaRoot)" />
  </Target>

</Project>
